# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rocketride managed connection (not used by this project's own tooling)
.rocketride/
.claude/
pnpm-lock.yaml

# prisma / sqlite database + local file storage for uploaded documents
*.db
*.db-journal
*.sqlite
*.sqlite3
*.tmp
/storage/
/storage/*
!/storage/.gitkeep
.env
.env.local
.env.*.local

# playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/

# presentation & deck generation artifacts
*.pptx
*.pdf
scripts/_deck_screens/
scripts/_capture_deck_screens.mjs
scripts/build_deck.py
