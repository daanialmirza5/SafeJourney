# SafeJourney environment configuration
# Copy to .env.local for local development. The app runs fully in DEMO_MODE
# with zero external credentials -- every variable below has a safe default.

# --- Core ---
DATABASE_URL="file:./dev.db" # resolved relative to prisma/schema.prisma -> prisma/dev.db
# SECURITY NOTE: In production, generate a high-entropy secret (e.g. `openssl rand -base64 32`)
JWT_SECRET="demo-insecure-secret-change-in-production"
APP_URL="http://localhost:3000"
DEMO_MODE="true" # Set to "false" in real production deployments with live auth & SMS/WhatsApp gateways

# --- Referral Rescue Engine ---
# Minutes after which an un-acknowledged referral is marked STUCK.
REFERRAL_ACK_TIMEOUT_MINUTES="10"

# --- AI provider abstraction ---
# AI_PROVIDER=demo runs a deterministic, offline, rule-based assistant.
# Set to "openai" | "anthropic" | "gemini" | "sarvam" and supply AI_API_KEY
# to use a real provider -- the app degrades gracefully without one.
AI_PROVIDER="demo"
AI_API_KEY=""

# --- OCR / document extraction abstraction ---
# OCR_PROVIDER=demo runs a deterministic, offline extraction stub.
OCR_PROVIDER="demo"
OCR_API_KEY=""

# --- Storage abstraction ---
# STORAGE_PROVIDER=local stores uploads on local disk under /storage.
# Set to "s3" and supply the bucket + credentials below for a real,
# working S3-compatible adapter (AWS S3, MinIO, DigitalOcean Spaces,
# Cloudflare R2, ...) -- if any of the three required values is missing,
# the app logs a warning and falls back to local instead of failing every
# upload. STORAGE_ENDPOINT is only needed for a non-AWS S3-compatible
# service; leave it unset for real AWS S3.
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""

# --- Notification provider abstractions (all default to in-app/demo) ---
EMAIL_PROVIDER="demo"
EMAIL_API_KEY=""
WHATSAPP_PROVIDER="demo"
WHATSAPP_API_KEY=""
